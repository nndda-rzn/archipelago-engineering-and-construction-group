# AEC API environment — copy ke .env
# JANGAN commit .env (Git-Workflow-Spec §12). .env.example adalah template.
#
# ⚠️ PENTING — variabel lingkungan yang sudah ada MENANG atas file .env.
# `dotenv` sengaja tidak menimpa variabel yang sudah di-set. Kalau Anda punya
# DATABASE_URL/REDIS_URL global (mis. dari proyek lain) di level User/Machine
# Windows, nilai di bawah akan DIABAIKAN dan API bisa menunjuk database yang
# salah — gejalanya `ECONNREFUSED` / HTTP 503 pada semua endpoint yang menyentuh
# DB. Saat boot, API kini memperingatkan dan mencetak target DB yang dipakai.
# Cek:      [System.Environment]::GetEnvironmentVariable('DATABASE_URL','User')
# Hapus:    [System.Environment]::SetEnvironmentVariable('DATABASE_URL', $null, 'User')

PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password

# PostgreSQL (infrastructure/docker/compose.dev.yml)
DATABASE_URL="postgresql://aec:aec_dev_password@localhost:5432/aec_erp?schema=public"
# Pool sizing (opsional — default pool=10, timeout=10s). Slow query threshold default 200ms.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_TIMEOUT=10
# SLOW_QUERY_MS=200

# CORS — daftar origin dipisah koma, atau '*' utk semua (production: domain web)
CORS_ORIGIN="https://aec.app.id"

# Trust proxy — true bila di belakang reverse-proxy/LB (IP asli utk rate limit & log)
TRUST_PROXY=true

# Logging (nestjs-pino) — debug/info/warn/error
LOG_LEVEL=debug

# Redis (infrastructure/docker/compose.dev.yml punya redis:7) — utk cache & BullMQ
REDIS_URL="redis://localhost:6379"

