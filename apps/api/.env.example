# AEC API environment — copy ke .env
# JANGAN commit .env (Git-Workflow-Spec §12). .env.example adalah template.

PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password

# PostgreSQL (infrastructure/docker/compose.dev.yml)
DATABASE_URL="postgresql://aec:aec_dev_password@localhost:5432/aec_erp?schema=public"

# CORS — daftar origin dipisah koma, atau '*' utk semua (production: domain web)
CORS_ORIGIN="https://aec.app.id"

# Trust proxy — true bila di belakang reverse-proxy/LB (IP asli utk rate limit & log)
TRUST_PROXY=true

