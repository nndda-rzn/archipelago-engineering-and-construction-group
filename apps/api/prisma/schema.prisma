// AEC ERP — Prisma schema
// Foundation domain (PRD §9.1, §16.2) — Phase 1 baseline
// Referensi: FR-FND-001 (legal entity), FR-FND-004 (RBAC), FR-FND-009 (number sequence)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Foundation domain ────────────────────────────────────────────────────────

// FR-FND-001: Multi-Legal Entity
model LegalEntity {
  id                String   @id @default(cuid())
  code              String   @unique // company code, mis. "AEC-CON"
  legalName         String
  taxIdentifier     String   @unique
  country           String
  functionalCurrency String  @default("IDR")
  reportingCurrency String   @default("IDR")
  fiscalCalendar    String   @default("STANDARD")
  status            String   @default("ACTIVE") // MasterDataStatus
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organizations Organization[]
  users         User[]
  projects      Project[]
}

// FR-FND-002: Effective-dated Organization
model Organization {
  id          String   @id @default(cuid())
  legalEntityId String
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id])
  name        String
  orgType     String // GROUP | LEGAL_ENTITY | BUSINESS_UNIT | DIVISION | REGION | BRANCH | DEPARTMENT | SECTION
  parentId    String?
  parent      Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children    Organization[] @relation("OrgHierarchy")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

// FR-FND-003: User (employee mapping disederhanakan untuk baseline)
model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  displayName   String
  passwordHash  String
  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id])
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id])
  status        String   @default("ACTIVE")
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userRoles     UserRole[]
}

// FR-FND-004: Role-Based Access Control — Resource + Action + Scope
model Role {
  id          String   @id @default(cuid())
  code        String   @unique // mis. "BUYER", "PROCUREMENT_MANAGER"
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique // mis. "PurchaseOrder.APPROVE"
  resource    String // mis. "PurchaseOrder"
  action      String // mis. "APPROVE"
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  scopeType    String @default("GLOBAL") // GLOBAL | LEGAL_ENTITY | BUSINESS_UNIT | PROJECT
  scopeValue   String @default("") // entity/project id bila scope terbatas

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId, scopeType, scopeValue])
}

model UserRole {
  userId String
  roleId String
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, effectiveFrom])
}

// ─── Project domain ───────────────────────────────────────────────────────────

// FR-PRJ-001: Project Master
model Project {
  id             String   @id @default(cuid())
  code           String   @unique // mis. "PRJ-EPC-2027-014"
  name           String
  client         String
  legalEntityId  String
  legalEntity    LegalEntity @relation(fields: [legalEntityId], references: [id])
  businessUnit   String?
  location       String?
  currency       String   @default("IDR")
  contractValue  Decimal? @db.Decimal(18, 2)
  startDate      DateTime?
  completionDate DateTime?
  director       String?
  manager        String?
  status         String   @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  wbsItems       WbsItem[]
  budgetItems    BudgetItem[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  warehouses     Warehouse[]
  goodsReceipts  GoodsReceipt[]
  stockLedgerEntries StockLedgerEntry[]
  materialIssues MaterialIssue[]
  adjustments   StockAdjustment[]
  opnames       StockOpname[]

  @@index([legalEntityId])
  @@index([status])
}

// FR-PRJ-002: WBS — hierarchical, unlimited practical depth
model WbsItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String // mis. "1", "1.1", "1.1.1"
  name        String
  description String?
  parentId    String?
  parent      WbsItem?  @relation("WbsHierarchy", fields: [parentId], references: [id])
  children    WbsItem[] @relation("WbsHierarchy")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budgetItems BudgetItem[]
  requisitions PurchaseRequisition[]
  poItems      PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]
  stockLedgerEntries StockLedgerEntry[]
  materialIssueItems MaterialIssueItem[]
  adjustmentItems StockAdjustmentItem[]
  opnameItems   StockOpnameItem[]

  @@unique([projectId, code])
  @@index([projectId])
}

// FR-PRJ-005/006: Budget baseline per WBS + cost type
model BudgetItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsItemId String
  wbsItem   WbsItem @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)
  costType  String  @default("DIRECT") // DIRECT | LABOR | MATERIAL | SUBCONTRACTOR | EQUIPMENT | INDIRECT | OVERHEAD
  amount    Decimal @db.Decimal(18, 2) // nilai budget (baseline)
  version   Int     @default(1)
  status    String  @default("DRAFT") // DRAFT | PUBLISHED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, wbsItemId, costType])
  @@index([projectId])
}

// ─── Procurement domain ───────────────────────────────────────────────────────

// FR-PRO-001: Purchase Requisition
model PurchaseRequisition {
  id        String   @id @default(cuid())
  prNumber  String   @unique // mis. "PR-2027-EPC-000001"
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  wbsItemId String?
  wbsItem   WbsItem? @relation(fields: [wbsItemId], references: [id])
  requestedBy String
  requestedAt DateTime @default(now())
  status    String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | CANCELLED
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@index([projectId])
  @@index([status])
}

model PurchaseRequisitionItem {
  id          String   @id @default(cuid())
  requisitionId String
  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(18, 2)
  unit        String   @default("EA")
  estimatedUnitPrice Decimal? @db.Decimal(18, 2)
  estimatedTotal Decimal? @db.Decimal(18, 2)

  @@index([requisitionId])
}

// FR-PRO-007: Purchase Order → commitment
model PurchaseOrder {
  id        String   @id @default(cuid())
  poNumber  String   @unique // mis. "PO-2027-EPC-000001"
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  requisitionId String?
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  vendor    String
  currency  String   @default("IDR")
  totalAmount Decimal @db.Decimal(18, 2) @default(0)
  status    String   @default("DRAFT") // DRAFT | APPROVED | RELEASED | CANCELLED
  issuedAt  DateTime?
  releasedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@index([projectId])
  @@index([status])
}

model PurchaseOrderItem {
  id         String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description String
  quantity   Decimal  @db.Decimal(18, 2)
  unit       String   @default("EA")
  unitPrice  Decimal  @db.Decimal(18, 2)
  totalPrice Decimal  @db.Decimal(18, 2)
  wbsItemId  String?
  wbsItem    WbsItem? @relation(fields: [wbsItemId], references: [id])

  goodsReceipts GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

// ─── Inventory domain ─────────────────────────────────────────────────────────

// FR-INV-002: Warehouse — corporate | project | temporary | virtual
model Warehouse {
  id         String   @id @default(cuid())
  code       String   @unique // mis. "WH-PROJ-014"
  name       String
  warehouseType String @default("PROJECT") // CORPORATE | PROJECT | TEMPORARY | VIRTUAL
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  location   String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  goodsReceipts GoodsReceipt[]
  stockLedgerEntries StockLedgerEntry[]
  materialIssues MaterialIssue[]
  adjustments   StockAdjustment[]
  opnames       StockOpname[]

  @@index([projectId])
}

// FR-PRO-009 (leg Receipt): terima barang dari RELEASED PO → stock ledger
model GoodsReceipt {
  id         String   @id @default(cuid())
  grNumber   String   @unique // mis. "GR-2027-EPC-000001"
  poId       String
  po         PurchaseOrder @relation(fields: [poId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  warehouseId String
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  receivedAt DateTime @default(now())
  receivedBy String
  status     String   @default("POSTED") // DRAFT | POSTED | CANCELLED
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items      GoodsReceiptItem[]

  @@index([poId])
  @@index([projectId])
  @@index([warehouseId])
}

model GoodsReceiptItem {
  id          String   @id @default(cuid())
  goodsReceiptId String
  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poItemId    String?
  poItem      PurchaseOrderItem? @relation(fields: [poItemId], references: [id])
  description String
  quantity    Decimal  @db.Decimal(18, 2) // qty diterima (bisa partial)
  unit        String   @default("EA")
  unitPrice   Decimal? @db.Decimal(18, 2)
  wbsItemId   String?
  wbsItem     WbsItem? @relation(fields: [wbsItemId], references: [id])

  @@index([goodsReceiptId])
}

// FR-INV-001: Stock Ledger — immutable movement records, qty current derivable
model StockLedgerEntry {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  wbsItemId  String?
  wbsItem    WbsItem? @relation(fields: [wbsItemId], references: [id])
  warehouseId String
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  documentType String // GR | ISSUE | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT | RESERVATION
  documentId String?  // id dokumen sumber (mis. GoodsReceiptItem.id)
  reference  String?  // no. dokumen (mis. "GR-2027-EPC-000001")
  description String?
  movementType String // IN | OUT | ADJUST
  quantity   Decimal  @db.Decimal(18, 2) // qty bertanda (positif IN / negatif OUT)
  unit       String   @default("EA")
  unitPrice  Decimal? @db.Decimal(18, 2)
  totalValue Decimal? @db.Decimal(18, 2)
  balanceAfter Decimal @db.Decimal(18, 2) // running balance (immutable snapshot)
  createdAt  DateTime @default(now())

  @@index([projectId, wbsItemId, warehouseId])
  @@index([documentType, documentId])
  @@index([createdAt])
}

// FR-INV-004: Material Issue — kurangi stock + project consumption
model MaterialIssue {
  id         String   @id @default(cuid())
  issueNumber String  @unique // mis. "MI-2027-EPC-000001"
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  warehouseId String
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  issuedTo   String // mis. "Tim Konstruksi", subcon, departemen
  issueReason String @default("CONSTRUCTION") // CONSTRUCTION | MAINTENANCE | CONSUMPTION | OTHERS
  issuedAt   DateTime @default(now())
  issuedBy   String
  remark     String?
  status     String   @default("POSTED") // DRAFT | POSTED | CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items      MaterialIssueItem[]

  @@index([projectId])
  @@index([warehouseId])
  @@index([status])
}

model MaterialIssueItem {
  id          String   @id @default(cuid())
  materialIssueId String
  materialIssue MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(18, 2) // qty keluar (positif di dokumen, ledger OUT negatif)
  unit        String   @default("EA")
  unitPrice   Decimal? @db.Decimal(18, 2) // cost saat issue (dari ledger/GR)
  totalValue  Decimal? @db.Decimal(18, 2)
  wbsItemId   String?
  wbsItem     WbsItem? @relation(fields: [wbsItemId], references: [id])

  @@index([materialIssueId])
}

// ─── Approval workflow (FR-FND-007) ──────────────────────────────────────────
// MVP: data-driven approval task per transaksi. Maker-checker BR-003.
// (Workflow definition/versioning penuh — menyusul)

// FR-FND-007: Approval step untuk transaksi (DRAFT → SUBMITTED → APPROVED/REJECTED)
model ApprovalTask {
  id            String   @id @default(cuid())
  transactionType String // "PurchaseRequisition" | "PurchaseOrder" | "Budget" | ...
  transactionId String
  transactionCode String? // no. dokumen (PR-..., PO-...) untuk display
  stepName      String   @default("approval")
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  requesterId   String // pembuat transaksi (BR-003: bukan approver)
  approverId    String? // resolved saat claim/approve
  approverRoleCode String // role yang boleh approve (mis. "PROCUREMENT_MANAGER")
  comment       String?
  decidedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([transactionType, transactionId])
  @@index([status])
  @@index([approverRoleCode])
}

// FR-INV-006: Stock Adjustment — wajib approval + reason code
model StockAdjustment {
  id         String   @id @default(cuid())
  adjustmentNumber String @unique // mis. "ADJ-2027-EPC-000001"
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  warehouseId String
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  reasonCode String // DAMAGE | LOSS | SURPLUS | REVALUATION | OTHERS
  reason     String?
  status     String   @default("DRAFT") // DRAFT | APPROVED | REJECTED | CANCELLED
  adjustedBy String
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items      StockAdjustmentItem[]

  @@index([projectId])
  @@index([warehouseId])
  @@index([status])
}

model StockAdjustmentItem {
  id            String   @id @default(cuid())
  stockAdjustmentId String
  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  description   String
  quantity      Decimal  @db.Decimal(18, 2) // delta: + surplus, - loss
  unit          String   @default("EA")
  unitPrice     Decimal? @db.Decimal(18, 2)
  wbsItemId     String?
  wbsItem       WbsItem? @relation(fields: [wbsItemId], references: [id])

  @@index([stockAdjustmentId])
}

// FR-INV-007: Stock Opname — count sheet + reconciliation
model StockOpname {
  id         String   @id @default(cuid())
  opnameNumber String @unique // mis. "OPN-2027-EPC-000001"
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  warehouseId String
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  status     String   @default("IN_PROGRESS") // DRAFT | IN_PROGRESS | RECONCILED | CLOSED
  countedBy  String
  countedAt  DateTime @default(now())
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items      StockOpnameItem[]

  @@index([projectId])
  @@index([warehouseId])
}

model StockOpnameItem {
  id         String   @id @default(cuid())
  stockOpnameId String
  stockOpname StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  description String
  bookQuantity Decimal @db.Decimal(18, 2) // stok sistem saat opname
  actualQuantity Decimal @db.Decimal(18, 2) // hasil hitung fisik
  difference  Decimal  @db.Decimal(18, 2) // actual - book
  unit        String   @default("EA")
  wbsItemId   String?
  wbsItem     WbsItem? @relation(fields: [wbsItemId], references: [id])

  @@index([stockOpnameId])
}

// FR-FND-009: Number Sequence (configurable)
model NumberSequence {
  id         String  @id @default(cuid())
  code       String  @unique // mis. "PR", "PO", "PRJ"
  prefix     String // mis. "PR-2027-EPC-"
  nextNumber Int     @default(1)
  padding    Int     @default(6)
  status     String  @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// FR-FND-008: Audit Trail (PRD §28) — immutable audit record
model AuditLog {
  id            String   @id @default(cuid())
  userId        String
  action        String // mis. "USER.LOGIN", "USER.CREATE", "LEGAL_ENTITY.BLOCK"
  resource      String
  resourceId    String?
  oldValue      Json?
  newValue      Json?
  reason        String?
  source        String   @default("api")
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([resource, resourceId])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
}
