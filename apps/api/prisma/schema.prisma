// AEC ERP — Prisma schema
// Foundation domain (PRD §9.1, §16.2) — Phase 1 baseline
// Referensi: FR-FND-001 (legal entity), FR-FND-004 (RBAC), FR-FND-009 (number sequence)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Foundation domain ────────────────────────────────────────────────────────

// FR-FND-001: Multi-Legal Entity
model LegalEntity {
  id                String   @id @default(cuid())
  code              String   @unique // company code, mis. "AEC-CON"
  legalName         String
  taxIdentifier     String   @unique
  country           String
  functionalCurrency String  @default("IDR")
  reportingCurrency String   @default("IDR")
  fiscalCalendar    String   @default("STANDARD")
  status            String   @default("ACTIVE") // MasterDataStatus
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organizations Organization[]
  users         User[]
  projects      Project[]
}

// FR-FND-002: Effective-dated Organization
model Organization {
  id          String   @id @default(cuid())
  legalEntityId String
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id])
  name        String
  orgType     String // GROUP | LEGAL_ENTITY | BUSINESS_UNIT | DIVISION | REGION | BRANCH | DEPARTMENT | SECTION
  parentId    String?
  parent      Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children    Organization[] @relation("OrgHierarchy")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

// FR-FND-003: User (employee mapping disederhanakan untuk baseline)
model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  displayName   String
  passwordHash  String
  legalEntityId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id])
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id])
  status        String   @default("ACTIVE")
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userRoles     UserRole[]
}

// FR-FND-004: Role-Based Access Control — Resource + Action + Scope
model Role {
  id          String   @id @default(cuid())
  code        String   @unique // mis. "BUYER", "PROCUREMENT_MANAGER"
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique // mis. "PurchaseOrder.APPROVE"
  resource    String // mis. "PurchaseOrder"
  action      String // mis. "APPROVE"
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  scopeType    String @default("GLOBAL") // GLOBAL | LEGAL_ENTITY | BUSINESS_UNIT | PROJECT
  scopeValue   String @default("") // entity/project id bila scope terbatas

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId, scopeType, scopeValue])
}

model UserRole {
  userId String
  roleId String
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, effectiveFrom])
}

// ─── Project domain ───────────────────────────────────────────────────────────

// FR-PRJ-001: Project Master
model Project {
  id             String   @id @default(cuid())
  code           String   @unique // mis. "PRJ-EPC-2027-014"
  name           String
  client         String
  legalEntityId  String
  legalEntity    LegalEntity @relation(fields: [legalEntityId], references: [id])
  businessUnit   String?
  location       String?
  currency       String   @default("IDR")
  contractValue  Decimal? @db.Decimal(18, 2)
  startDate      DateTime?
  completionDate DateTime?
  director       String?
  manager        String?
  status         String   @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  wbsItems       WbsItem[]
  budgetItems    BudgetItem[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]

  @@index([legalEntityId])
  @@index([status])
}

// FR-PRJ-002: WBS — hierarchical, unlimited practical depth
model WbsItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String // mis. "1", "1.1", "1.1.1"
  name        String
  description String?
  parentId    String?
  parent      WbsItem?  @relation("WbsHierarchy", fields: [parentId], references: [id])
  children    WbsItem[] @relation("WbsHierarchy")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budgetItems BudgetItem[]
  requisitions PurchaseRequisition[]
  poItems      PurchaseOrderItem[]

  @@unique([projectId, code])
  @@index([projectId])
}

// FR-PRJ-005/006: Budget baseline per WBS + cost type
model BudgetItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsItemId String
  wbsItem   WbsItem @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)
  costType  String  @default("DIRECT") // DIRECT | LABOR | MATERIAL | SUBCONTRACTOR | EQUIPMENT | INDIRECT | OVERHEAD
  amount    Decimal @db.Decimal(18, 2) // nilai budget (baseline)
  version   Int     @default(1)
  status    String  @default("DRAFT") // DRAFT | PUBLISHED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, wbsItemId, costType])
  @@index([projectId])
}

// ─── Procurement domain ───────────────────────────────────────────────────────

// FR-PRO-001: Purchase Requisition
model PurchaseRequisition {
  id        String   @id @default(cuid())
  prNumber  String   @unique // mis. "PR-2027-EPC-000001"
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  wbsItemId String?
  wbsItem   WbsItem? @relation(fields: [wbsItemId], references: [id])
  requestedBy String
  requestedAt DateTime @default(now())
  status    String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | CANCELLED
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@index([projectId])
  @@index([status])
}

model PurchaseRequisitionItem {
  id          String   @id @default(cuid())
  requisitionId String
  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(18, 2)
  unit        String   @default("EA")
  estimatedUnitPrice Decimal? @db.Decimal(18, 2)
  estimatedTotal Decimal? @db.Decimal(18, 2)

  @@index([requisitionId])
}

// FR-PRO-007: Purchase Order → commitment
model PurchaseOrder {
  id        String   @id @default(cuid())
  poNumber  String   @unique // mis. "PO-2027-EPC-000001"
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  requisitionId String?
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  vendor    String
  currency  String   @default("IDR")
  totalAmount Decimal @db.Decimal(18, 2) @default(0)
  status    String   @default("DRAFT") // DRAFT | APPROVED | RELEASED | CANCELLED
  issuedAt  DateTime?
  releasedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PurchaseOrderItem[]

  @@index([projectId])
  @@index([status])
}

model PurchaseOrderItem {
  id         String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description String
  quantity   Decimal  @db.Decimal(18, 2)
  unit       String   @default("EA")
  unitPrice  Decimal  @db.Decimal(18, 2)
  totalPrice Decimal  @db.Decimal(18, 2)
  wbsItemId  String?
  wbsItem    WbsItem? @relation(fields: [wbsItemId], references: [id])

  @@index([purchaseOrderId])
}

// FR-FND-009: Number Sequence (configurable)
model NumberSequence {
  id         String  @id @default(cuid())
  code       String  @unique // mis. "PR", "PO", "PRJ"
  prefix     String // mis. "PR-2027-EPC-"
  nextNumber Int     @default(1)
  padding    Int     @default(6)
  status     String  @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// FR-FND-008: Audit Trail (PRD §28) — immutable audit record
model AuditLog {
  id            String   @id @default(cuid())
  userId        String
  action        String // mis. "USER.LOGIN", "USER.CREATE", "LEGAL_ENTITY.BLOCK"
  resource      String
  resourceId    String?
  oldValue      Json?
  newValue      Json?
  reason        String?
  source        String   @default("api")
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([resource, resourceId])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
}
