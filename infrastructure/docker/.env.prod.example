# Production environment — copy ke .env.prod (JANGAN commit .env.prod)
# Sumber: infrastructure/docker/.env.prod.example

# App
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-64-char-secret
CORS_ORIGIN="https://aec.app.id"
TRUST_PROXY=true
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=aec
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=aec_erp
DATABASE_URL="postgresql://aec:replace-with-strong-db-password@postgres:5432/aec_erp?schema=public"

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL="redis://:replace-with-strong-redis-password@redis:6379"
