# Root environment file untuk docker compose
# Copy ke .env dan sesuaikan. JANGAN commit .env (Git-Workflow-Spec §12).

# PostgreSQL
POSTGRES_USER=aec
POSTGRES_PASSWORD=aec_dev_password
POSTGRES_DB=aec_erp

# MinIO
MINIO_ROOT_USER=aec
MINIO_ROOT_PASSWORD=aec_dev_password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
